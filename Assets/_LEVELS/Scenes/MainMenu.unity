  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Ninja Adventure \u2013 Asset Pack</b> \xB7 Pixel-Boy und AAA \xB7 CC0 1.0 Universal\nSamurai, Schwert, Portr\xE4t und Club sowie Gel\xE4nde, Geb\xE4ude und Requisiten. Sprite-Ausschnitte arrangiert und in Atlanten kombiniert. Einzelne Szenenelemente gespiegelt, gef\xE4rbt oder zusammengesetzt. Turmvarianten aus den Demo-Tilesets und Update #6.\nhttps://pixel-boy.itch.io/ninja-adventure-asset-pack\nhttps://github.com/pixel-boy/NinjaAdventure/tree/6ac78232d5aedcc85ce5f27d060ea92366f7c24a\nhttps://pixel-boy.itch.io/ninja-adventure-asset-pack/devlog/763041/update-6-boss-spell-icons-towers\n\n<b>Pixelated Goblin</b> \xB7 markoxx2 \xB7 CC0 1.0 Universal\nGoblin-Idle- und Walk-Sheets f\xFCr alle vier Richtungen geschnitten, in einen Atlas gepackt, Fu\xDFpunkte ausgerichtet und in Unity skaliert.\nhttps://opengameart.org/content/pixelated-goblin\n\n<b>16x16 Puny World Tileset</b> \xB7 Shade \xB7 CC0 1.0 Universal\nAcht Plateau-Kanten und -Ecken zugeschnitten, Hintergrund entfernt und Felspalette angepasst.\nhttps://opengameart.org/content/16x16-puny-world-tileset\n\n<b>Puny Characters (Orcs Included)</b> \xB7 Shade \xB7 CC0 1.0 Universal\n<b>Animated Walk-Cycle Monsters + Hijabi from Eman Quest</b> \xB7 Night Blade \xB7 CC0 1.0 Universal\nCyclops aus Orc-Soldier-Cyan und eye-rock, zugeschnitten, umgef\xE4rbt und mit dem Club aus Ninja Adventure (Pixel-Boy und AAA) kombiniert.\nhttps://opengameart.org/content/puny-characters\nhttps://opengameart.org/content/animated-walk-cycle-monsters-hijabi-from-eman-quest\n\n<b>Liberation Sans</b> \xB7 Google Corporation (digitalisierte Daten, 2010), Red Hat, Inc. (2012) \xB7 SIL Open Font License 1.1\nhttps://scripts.sil.org/OFL"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
